# ClickHouse — credentials de connexion
CLICKHOUSE_USER=admin
CLICKHOUSE_PASSWORD=

# Airbyte OSS — OAuth2 Client Credentials (abctl local credentials)
AIRBYTE_CLIENT_ID=
AIRBYTE_CLIENT_SECRET=

# Airbyte — UUIDs des connexions (api/public/v1/connections)
# Obligatoires — le scheduler Airflow crashe si absents
AIRBYTE_CONN_ERP=
AIRBYTE_CONN_CRM=
AIRBYTE_CONN_MKT=

# Optionnels — le DAG tourne sans eux (dbt s'exécute, Airbyte sync skippé)
# Renseigner au fur et à mesure que les connexions sont créées dans Airbyte
AIRBYTE_CONN_WMS=
AIRBYTE_CONN_MES=
AIRBYTE_CONN_MARKETING=
AIRBYTE_CONN_SAV=
AIRBYTE_CONN_PLM=
AIRBYTE_CONN_SIRH=
AIRBYTE_CONN_QMS=
AIRBYTE_CONN_FINANCE=
AIRBYTE_CONN_PROCUREMENT=
